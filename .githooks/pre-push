#!/usr/bin/env bash
# Local CI gate. The one GitHub Actions workflow only deploys the docs site,
# so `just ci` runs here: index guard, lint, format, docstrings, prose, the Any ratchet,
# typecheck, unit tests and the strict docs build.
#
# Install: just hooks-install
# Bypass:  git push --no-verify   (use sparingly, and say why)
set -euo pipefail

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' is not on PATH — cannot run the CI gate." >&2
    echo "pre-push: install just, or bypass with 'git push --no-verify'." >&2
    exit 1
fi

echo "pre-push: running 'just ci'..."
just ci

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

# Scratch / temp files
*.zip
*.bak
site/

# Catalog folders and DuckDB files a local run writes
*_catalog/
*.duckdb
.env
.envrc

# DuckDB spill files (large queries page to disk here)
.tmp/

# uv lockfile — statcat-serve follows the suite libraries; downstream consumers
# resolve against pyproject.toml. Committing the lockfile would leak
# whichever package index the local environment resolved against.
uv.lock

# Coverage output (`just coverage`)
.coverage
.coverage.*
coverage.xml
htmlcov/
